TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_client_id
GUILD_ID=your_discord_server_id
# Railway: mount a Volume at /data and set DATA_DIR=/data
# Local default: ./data
# DATA_DIR=/data
# JMA list polling: default/minimum 30000 ms, maximum 300000 ms.
# CDN caching can delay upstream updates; failures back off and respect Retry-After.
# JMA_POLL_INTERVAL_MS=30000

# 開発用の起動で共有プロフィールを上書きしない場合は false
BOT_PROFILE_UPDATE=true
